# ── Secrets & credentials ────────────────────────────────────────────
.env
.env.*
!.env.example
# Telethon login session (treat as a credential)
*.session
*.session-journal
# Google Cloud service-account keys
service-account*.json
*-credentials.json

# ── Runtime state ────────────────────────────────────────────────────
.trading_halted        # kill-switch flag written by the `sleep` command
.tp_registry.json      # take-profits the bot itself placed (drives the morning sweep)
.guard_state.json      # guard alert episodes / snoozes

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Test scripts ─────────────────────────────────────────────────────
test_*.py

# ── Downloaded signal images + metadata (may contain account data) ───
signal_examples/
recent_signals/
legit_signals/
new channel signals/
archive_fetch.log
