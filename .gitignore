fetch_archive.py
fetch_recent_signals.py
sort_legit_signals.py
scrape_tws_docs.py

# ── Client-facing analysis of the signal channel (not for the public repo) ──
Signal_Analysis_Report.pdf
Backtest_Report*.pdf
make_report.py
make_backtest_report.py
make_client_report.py
*incident_report*.txt

# ── Stray temp / debug dumps ─────────────────────────────────────────
*.b64
gateway_*.png
gateway_*.b64
CUsers*
C:Users*

